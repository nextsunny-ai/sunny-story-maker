# ============================================================
# SUNNY Story Maker V2 — 환경 변수 (Vercel 배포용)
# ============================================================
# 사용법:
#   1) 이 파일을 .env.local로 복사
#   2) 아래 값들을 실제 값으로 채움
#   3) Vercel 배포 시 Vercel.com → Project Settings → Environment Variables
#      에 동일한 키/값을 입력 (NEXT_PUBLIC_ 변수는 그대로, 시크릿은 Server-only)

# ─── Anthropic (필수) ──────────────────────────────────────
# https://console.anthropic.com/settings/keys 에서 발급
# 서버 측에서만 사용 (NEXT_PUBLIC_ 안 붙임)
ANTHROPIC_API_KEY=sk-ant-...

# 사용 모델 (변경 시 시스템 프롬프트 캐시 무효화됨)
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# ─── Supabase (필수) ───────────────────────────────────────
# https://supabase.com/dashboard → 프로젝트 → Project Settings → API
# NEXT_PUBLIC_ prefix는 브라우저에서도 접근 가능 (anon key는 안전)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# 서버 측 전용 service role key (선택 — admin 작업 필요 시)
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── 초대 코드 (필수, 베타 기간) ────────────────────────────
# 신규 가입자가 입력해야 가입 가능. 클라이언트(가입 폼)에서 검증하기 위해
# NEXT_PUBLIC_INVITE_CODE 도 동일 값으로 설정. 베타 한정이라 안전.
INVITE_CODE=SUNNY2026!
NEXT_PUBLIC_INVITE_CODE=SUNNY2026!

# ─── 외부 동기화 (선택) ────────────────────────────────────
# Google Drive / OneDrive 등에 출력물 자동 백업 폴더 (로컬 dev에서만)
DRIVE_OUTPUT_DIR=

# ─── 작가 피드백 이메일 (★ 2026-05-20 대표님 명시) ───────────
# 작가가 💬 위젯에서 [메일로 보내기] 클릭 = 작가 본인 메일 앱 열림 (mailto:)
# = 작가 본인 이메일에서 sunny@sunnyent.co.kr로 발송.
# 사장님 측 환경변수 박을 거 없음 (= 비용 0, Resend·SMTP X).
# 사장님이 답장 = 일반 메일 thread = 작가에게 바로 전달.
#
# 작가 메시지는 Supabase feedbacks 테이블에도 자동 저장 = /admin/dashboard에서 백업 검색.

# ─── 운영 대시보드 접근 권한 (선택) ───────────────────────────
# /admin/dashboard = 작가 피드백·에러·구독 한 화면. ADMIN_EMAILS에 박힌 이메일만 접근.
# 디폴트 = nextsunny@gmail.com 만. 콤마(,) 구분.
# ADMIN_EMAILS=nextsunny@gmail.com,sunny@sunnyent.co.kr
